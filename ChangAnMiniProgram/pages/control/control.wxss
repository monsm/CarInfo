.ctrl { padding-top: 16rpx; }

.stage {
  margin: 0 0 24rpx;
  padding: 26rpx 32rpx 30rpx;
  overflow: hidden;
}
.stage::after {
  content: '';
  position: absolute;
  top: -160rpx; left: 6%; right: 6%; height: 360rpx;
  background: radial-gradient(62% 100% at 50% 0%, rgba(170, 205, 255, 0.18), rgba(170, 205, 255, 0.06) 48%, transparent 72%);
  pointer-events: none;
}
.stage-top {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 4rpx;
}
.car-line { display: flex; align-items: center; min-width: 0; }
.car-name {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  color: #FFFFFF;
}
.car-chev { width: 24rpx; height: 24rpx; opacity: 0.6; margin-left: 12rpx; flex-shrink: 0; }
.status-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.04));
  background-color: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.09);
  flex-shrink: 0;
  margin-left: 20rpx;
}
.status-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: var(--ok);
  box-shadow: 0 0 12rpx rgba(48, 192, 95, 0.7);
  flex-shrink: 0;
}
.status-t { font-size: 21rpx; color: var(--tx-3); white-space: nowrap; }
.status-pill.err { border-color: rgba(255, 90, 79, 0.4); }
.status-pill.err .status-dot { background: var(--bad); box-shadow: 0 0 12rpx rgba(255, 90, 79, 0.7); }
.status-pill.err .status-t { color: var(--bad); }

.ct-hero {
  display: flex;
  justify-content: center;
  gap: 96rpx;
  padding: 36rpx 0 8rpx;
}
.citem { display: flex; flex-direction: column; align-items: center; gap: 22rpx; min-width: 0; }
.disc {
  position: relative;
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.disc-halo {
  position: absolute; inset: -10rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.20);
  box-shadow: inset 0 0 24rpx rgba(255, 255, 255, 0.07);
  pointer-events: none;
}
.disc.solid {
  background: linear-gradient(180deg, #FFFFFF, #E3E8EF 80%, #F1F4F8);
  box-shadow:
    0 0 0 10rpx rgba(255, 255, 255, 0.07),
    0 24rpx 56rpx -14rpx rgba(255, 255, 255, 0.26),
    0 24rpx 56rpx rgba(0, 0, 0, 0.55),
    inset 0 -6rpx 14rpx rgba(0, 0, 0, 0.08),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
}
.disc.ghost {
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.045));
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.5), inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  -webkit-backdrop-filter: blur(24rpx) saturate(1.5);
  backdrop-filter: blur(24rpx) saturate(1.5);
}
.disc-ic { width: 72rpx; height: 72rpx; opacity: 1; }
.disc.disabled { opacity: 0.35; }
.disc-spin {
  position: absolute;
  inset: -10rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(77, 166, 255, 0.2);
  border-top-color: var(--acc);
  animation: spin 0.9s linear infinite;
  pointer-events: none;
}
.disc-t { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.disc-name { font-size: 30rpx; font-weight: 600; }
.disc-en { font-size: 18rpx; letter-spacing: 2rpx; }

.ct-run {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 20rpx 0 0;
}
.run-sp {
  width: 28rpx; height: 28rpx; border-radius: 50%;
  border: 3rpx solid rgba(77, 166, 255, 0.22);
  border-top-color: var(--acc);
  animation: spin 0.8s linear infinite;
  flex-shrink: 0;
}
.run-m { display: flex; align-items: baseline; }
.run-t { font-size: 27rpx; font-weight: 500; }
.run-s { font-size: 21rpx; color: var(--tx-3); margin-left: 20rpx; }

.console { padding: 0; }

.cmd-grid {
  display: flex;
  gap: 14rpx;
}
.cmd-tile {
  flex: 1;
  min-width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 6rpx 20rpx;
  border-radius: 20rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.09);
}
.cmd-tile::before { content: none; }
.cmd-wide { flex: 1; min-width: 0; }
.cmd-tile.disabled { opacity: 0.35; }
.ct-ic-box {
  width: 56rpx; height: 56rpx;
  border-radius: 18rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.11);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.ct-ic { width: 28rpx; height: 28rpx; opacity: 1; }
.ct-txt {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}
.ct-name {
  font-size: 20rpx; font-weight: 500; line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  max-width: 100%;
}
.ct-note {
  font-size: 17rpx; color: var(--tx-3); margin-top: 2rpx; line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  max-width: 100%;
}
.cmd-state {
  position: absolute;
  top: 14rpx; right: 14rpx;
  display: flex; align-items: center;
}
.cmd-spin {
  width: 20rpx; height: 20rpx; border-radius: 50%;
  border: 3rpx solid rgba(77, 166, 255, 0.25);
  border-top-color: var(--acc);
  animation: spin 0.8s linear infinite;
}

.body-sum { font-size: 22rpx; color: var(--tx-3); }
.body-sum.ok { color: var(--ok); }
.body-sum.bad { color: var(--bad); text-shadow: 0 0 14rpx rgba(255, 90, 79, 0.3); }
.bd-sec { margin-top: 6rpx; }
.bd-sec + .bd-sec { margin-top: 24rpx; }
.bd-sec-t { font-size: 18rpx; letter-spacing: 1.4rpx; margin-bottom: 12rpx; }
.bd-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.bd-cell {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}
.bd-cell::before { content: none; }
.bd-k { font-size: 20rpx; color: var(--tx-2); flex-shrink: 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bd-v { font-size: 20rpx; font-weight: 500; text-align: right; white-space: nowrap; }
.bd-v.ok { color: var(--tx-3); }
.bd-v.bad { color: var(--bad); text-shadow: 0 0 12rpx rgba(255, 90, 79, 0.3); }

.log {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}
.log + .log { border-top: 1rpx solid rgba(255, 255, 255, 0.05); }
.log-time {
  font-size: 18rpx; color: var(--tx-3);
  white-space: nowrap;
  margin-right: 22rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.log-main {
  flex: 1; min-width: 0;
  display: flex; align-items: baseline; flex-wrap: wrap;
  column-gap: 18rpx; row-gap: 4rpx;
}
.log-name { font-size: 27rpx; font-weight: 500; line-height: 1.4; min-width: 0; }
.log-status { font-size: 20rpx; flex-shrink: 0; margin-left: auto; }
.log-status.ok { color: var(--ok); }
.log-status.bad { color: var(--bad); text-shadow: 0 0 12rpx rgba(255, 90, 79, 0.3); }
.log-status.warn { color: var(--warn); }
.log-desc {
  width: 100%;
  font-size: 20rpx; color: var(--tx-3);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  margin-top: 6rpx;
}

.note {
  font-size: 21rpx;
  color: var(--tx-3);
  padding: 8rpx 4rpx 0;
  text-align: center;
  line-height: 1.9;
}