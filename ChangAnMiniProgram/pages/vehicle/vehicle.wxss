/* ============ 车辆档案 v15：名片卡 + 分区卡片 ============ */
.veh { padding-top: 16rpx; }
.veh-eyebrow { padding: 18rpx 4rpx 34rpx; }
.veh-eyebrow .caps { font-size: 18rpx; letter-spacing: 2.5rpx; }

/* 名片卡 */
.vcard {
  margin: 0 0 24rpx;
  padding: 34rpx 32rpx 32rpx;
  overflow: hidden;
}
.vcard::after {
  content: '';
  position: absolute;
  top: -160rpx; left: 8%; right: 8%; height: 360rpx;
  background: radial-gradient(62% 100% at 50% 0%, rgba(170, 205, 255, 0.17), rgba(170, 205, 255, 0.06) 48%, transparent 72%);
  pointer-events: none;
}
.vc-top { display: flex; align-items: center; }
.vc-name {
  font-size: 48rpx; font-weight: 600; letter-spacing: -1rpx; line-height: 1.15;
  color: #FFFFFF;
}
.nev-pill {
  margin-left: 22rpx;
  font-size: 17rpx; letter-spacing: 1.5rpx;
  color: var(--acc);
  background: rgba(77, 166, 255, 0.08);
  border: 1rpx solid rgba(77, 166, 255, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.vc-plate { margin-top: 24rpx; font-size: 17rpx; letter-spacing: 2rpx; }

.vc-vin {
  display: flex; align-items: center;
  margin-top: 36rpx;
  padding: 24rpx 28rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  border-radius: 18rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.09);
}
.vc-vin::before { content: none; }
.vin-t { flex: 1; min-width: 0; font-size: 21rpx; color: var(--tx-2); letter-spacing: 1rpx; line-height: 1.7; }
.vin-copy { width: 28rpx; height: 28rpx; opacity: 0.8; margin-left: 20rpx; }

.vc-hr { height: 1rpx; background: rgba(255, 255, 255, 0.07); margin: 30rpx 0 0; }
.vc-hr::after { content: none; }
.vc-line {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 34rpx;
}
.vc-pin { display: flex; align-items: center; }
.vc-pin .caps { font-size: 19rpx; letter-spacing: 2rpx; margin-right: 18rpx; }
.vc-pin .fine { font-size: 19rpx; }
.srv { display: flex; gap: 14rpx; flex-wrap: wrap; justify-content: flex-end; }
.pill { padding: 6rpx 20rpx; font-size: 20rpx; }
.pill .dot { width: 8rpx; height: 8rpx; margin-right: 10rpx; }

.v-mono { font-size: 21rpx; }

/* ---------- 分区卡片 ---------- */
.sec { position: relative; }
.sec-seam { display: none; }
.seam-glint { display: none; }
.sec-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0 2rpx;
}
.sec-stamp { display: flex; align-items: center; }
.sec-no {
  font-size: 22rpx; font-weight: 500;
  color: var(--tx-4);
  line-height: 1;
  margin-right: 16rpx;
  font-variant-numeric: tabular-nums;
}
.sec-title { font-size: 32rpx; font-weight: 600; line-height: 1.3; letter-spacing: -0.5rpx; }