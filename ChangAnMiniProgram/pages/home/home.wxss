.home { padding-top: 16rpx; }

.waiting {
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx; padding: 60rpx 0;
}
.spinner {
  width: 30rpx; height: 30rpx; border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.16); border-top-color: #FFFFFF;
  animation: spin 0.8s linear infinite;
}

.stage {
  margin: 0 0 24rpx;
  padding: 26rpx 32rpx 30rpx;
  overflow: hidden;
}
.stage::before {
  content: '';
  position: absolute;
  left: 10%; right: 10%; bottom: 44rpx; height: 140rpx;
  background: radial-gradient(50% 100% at 50% 100%, rgba(120, 165, 255, 0.16), transparent 72%);
  pointer-events: none;
}
.stage::after {
  content: '';
  position: absolute;
  top: -160rpx; left: 6%; right: 6%; height: 360rpx;
  background: radial-gradient(62% 100% at 50% 0%, rgba(170, 205, 255, 0.18), rgba(170, 205, 255, 0.06) 48%, transparent 72%);
  pointer-events: none;
}
.stage-top {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 4rpx;
}
.greet { font-size: 21rpx; letter-spacing: 1.5rpx; color: var(--tx-2); }
.stage-id {
  display: flex; align-items: baseline;
  padding: 12rpx 4rpx 0;
}
.pick { display: flex; align-items: center; }
.car-name {
  font-size: 40rpx; font-weight: 600; letter-spacing: -0.5rpx;
  color: #FFFFFF;
}
.pick-chev { width: 24rpx; height: 24rpx; opacity: 0.6; margin-left: 12rpx; }
.plate { margin-left: 22rpx; font-size: 20rpx; letter-spacing: 1.5rpx; color: var(--tx-3); }
.rb {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.05));
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12), 0 8rpx 20rpx -8rpx rgba(0, 0, 0, 0.5);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.rb-ic { width: 26rpx; height: 26rpx; opacity: 1; }

.breath { animation: breath 2.2s ease-in-out infinite; }

.scene {
  position: relative;
  height: 260rpx;
  display: flex; align-items: flex-end; justify-content: center;
  margin-top: 6rpx;
}
.halo {
  position: absolute; left: 50%; bottom: 0;
  width: 300rpx; height: 300rpx;
  margin-left: -150rpx;
  pointer-events: none;
}
.hero-car {
  position: relative; z-index: 2; width: 520rpx;
  margin-bottom: 18rpx;
  filter: drop-shadow(0 24rpx 22rpx rgba(0, 0, 0, 0.55));
}
.scene-floor {
  position: absolute; left: 14%; right: 14%; bottom: 4rpx; height: 26rpx;
  background: radial-gradient(50% 100% at 50% 50%, rgba(190, 220, 255, 0.28), transparent 70%);
  border-radius: 50%;
  filter: blur(2rpx);
  pointer-events: none;
}
.chg-note {
  position: absolute; left: 26rpx; bottom: 18rpx; z-index: 3;
  display: flex; align-items: center;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.05));
  background-color: rgba(18, 22, 30, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  -webkit-backdrop-filter: blur(30rpx) saturate(1.6);
  backdrop-filter: blur(30rpx) saturate(1.6);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}
.chg-note .dot { margin-right: 12rpx; }
.chg-t { font-size: 25rpx; font-weight: 500; font-variant-numeric: tabular-nums; }
.chg-sub { margin-left: 14rpx; font-size: 19rpx; letter-spacing: 1.5rpx; }

.digits-wrap { padding: 6rpx 4rpx 0; }
.h-eyebrow {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 8rpx;
}
.digits { display: flex; align-items: stretch; padding: 10rpx 0 0; }
.soc {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-width: 0;
}
.soc .d1 { font-size: 128rpx; }
.soc .pct { font-size: 40rpx; font-weight: 200; color: var(--tx-3); margin-left: 10rpx; }
.rg {
  flex: 1.05;
  display: flex; flex-direction: column; justify-content: center; min-width: 0;
  margin-left: 28rpx; padding-left: 28rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.09);
}
.rg::before { content: none; }
.rg-lab { font-size: 19rpx; letter-spacing: 1rpx; }
.rg-v { display: flex; align-items: baseline; margin-top: 10rpx; }
.rg-v .d3 { font-size: 60rpx; }
.rg-u { font-size: 21rpx; color: var(--tx-3); margin-left: 12rpx; }
.rg-sub { font-size: 19rpx; color: var(--tx-2); margin-top: 10rpx; }
.rg.na .rg-na { margin-top: 18rpx; font-size: 23rpx; color: var(--tx-3); }

.run {
  display: flex;
  margin: 28rpx 4rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  padding: 6rpx 0 0;
}
.rm {
  flex: 1; min-width: 0;
  box-sizing: border-box;
  display: flex; flex-direction: column;
  padding: 18rpx 0 0;
  position: relative;
  overflow: hidden;
}
.rm + .rm { padding-left: 24rpx; }
.rm + .rm::before {
  content: '';
  position: absolute; left: 0; top: 26%; bottom: 6%; width: 1rpx;
  background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.12), transparent);
}
.rk { font-size: 18rpx; letter-spacing: 1rpx; color: var(--tx-3); white-space: nowrap; }
.rv { font-size: 28rpx; color: var(--tx); font-weight: 500; margin-top: 8rpx; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ru { font-size: 18rpx; color: var(--tx-3); margin-left: 6rpx; font-weight: 400; }

.qdock {
  margin: 0 0 24rpx;
  display: flex;
}
.qd-inner {
  flex: 1;
  display: flex;
  padding: 8rpx;
  border-radius: 28rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.06));
  background-color: rgba(21, 26, 35, 0.64);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow:
    0 22rpx 56rpx -22rpx rgba(0, 0, 0, 0.65),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.15);
  -webkit-backdrop-filter: blur(48rpx) saturate(1.7);
  backdrop-filter: blur(48rpx) saturate(1.7);
}
.qseg {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  gap: 10rpx;
  padding: 20rpx 0;
  border-radius: 22rpx;
  min-width: 0;
}
.qseg:active { background: rgba(255, 255, 255, 0.08); }
.qseg-ic { width: 30rpx; height: 30rpx; flex-shrink: 0; opacity: 1; }
.qseg-t { font-size: 21rpx; color: var(--tx); letter-spacing: 0.5rpx; white-space: nowrap; }

.console { padding: 0; }

.st { display: flex; align-items: center; padding: 26rpx 0; }
.st + .st { border-top: 1rpx solid rgba(255, 255, 255, 0.05); }
.st-ic-box {
  width: 64rpx; height: 64rpx;
  border-radius: 18rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.11);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.st-ic-box::before { content: none; }
.st-ic { width: 32rpx; height: 32rpx; opacity: 1; }
.st-main { flex: 1; min-width: 0; display: flex; flex-direction: column; margin-left: 24rpx; }
.st-line { display: flex; align-items: baseline; min-width: 0; }
.st-name { font-size: 28rpx; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.st-v { margin-left: auto; padding-left: 20rpx; font-size: 22rpx; font-weight: 500; flex-shrink: 0; }
.st-v.ok { color: var(--tx-3); }
.st-v.warn { color: var(--warn); text-shadow: 0 0 16rpx rgba(255, 179, 64, 0.3); }
.st-v.bad { color: var(--bad); text-shadow: 0 0 16rpx rgba(255, 90, 79, 0.3); }
.st-v.na { color: var(--tx-4); }
.st-sub {
  margin-top: 8rpx; font-size: 20rpx; line-height: 1.5; color: var(--tx-3);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.st-go { width: 22rpx; height: 22rpx; opacity: 0.55; margin-left: 18rpx; flex-shrink: 0; }

.bars { width: 100%; margin: 2rpx 0 10rpx; }
.cell-pills { display: flex; margin: 18rpx 0 4rpx; }
.cpill {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  padding: 24rpx 0 22rpx;
  position: relative;
}
.cpill + .cpill::before {
  content: '';
  position: absolute; left: 0; top: 22%; bottom: 22%; width: 1rpx;
  background: rgba(255, 255, 255, 0.1);
}
.cp-k { font-size: 18rpx; color: var(--tx-3); letter-spacing: 1rpx; }
.cp-v { font-size: 30rpx; color: var(--tx); font-weight: 500; margin-top: 12rpx; font-variant-numeric: tabular-nums; }
.cpill.bad .cp-v { color: var(--bad); text-shadow: 0 0 16rpx rgba(255, 90, 79, 0.3); }
.lr { display: flex; align-items: baseline; padding: 24rpx 0 0; }
.lr-k { font-size: 21rpx; color: var(--tx-3); flex-shrink: 0; margin-right: 20rpx; }
.lr-v { font-size: 23rpx; flex: 1; min-width: 0; word-break: break-all; }

.bd-toggle {
  display: flex; justify-content: space-between; align-items: center;
  padding: 4rpx 2rpx 6rpx;
}
.bd-toggle text { font-size: 19rpx; letter-spacing: 1rpx; color: var(--tx-3); }
.bd-grid {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin: 14rpx 0 2rpx;
}
.bd-cell {
  width: calc(50% - 6rpx); box-sizing: border-box;
  border-radius: 18rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  padding: 18rpx 22rpx;
  display: flex; flex-direction: column;
}
.bd-cell::before { content: none; }
.bd-line { display: flex; align-items: center; }
.bd-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 12rpx; flex-shrink: 0; }
.bd-dot.ok { background: var(--ok); box-shadow: 0 0 10rpx rgba(48, 192, 95, 0.6); }
.bd-dot.warn { background: var(--warn); box-shadow: 0 0 10rpx rgba(255, 179, 64, 0.6); }
.bd-dot.bad { background: var(--bad); box-shadow: 0 0 10rpx rgba(255, 90, 79, 0.6); }
.bd-dot.na { background: rgba(255, 255, 255, 0.2); }
.bd-k { font-size: 20rpx; color: var(--tx-3); }
.bd-v { margin-top: 8rpx; font-size: 23rpx; color: var(--tx-2); }
.bd-v.bad { color: var(--bad); }

.tyre-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 30rpx; padding: 0 2rpx;
}
.tyre-head .caps { font-size: 18rpx; letter-spacing: 2rpx; }
.tyre-more { font-size: 20rpx; }
.tyre-more.ok { color: var(--tx-3); }
.tyre-more.bad { color: var(--bad); }
.tyre-more.na { color: var(--tx-4); }
.tyre-wrap { position: relative; width: 520rpx; margin: 12rpx auto 0; }
.topview { display: block; width: 520rpx; height: 260rpx; }
.wheel {
  position: absolute;
  width: 136rpx; height: 84rpx;
  border-radius: 20rpx;
  background: rgba(14, 17, 23, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 12rpx 26rpx rgba(0, 0, 0, 0.55), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.5);
  backdrop-filter: blur(20rpx) saturate(1.5);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.wheel.w-fl { left: 68rpx; top: 40rpx; }
.wheel.w-fr { left: 68rpx; top: 136rpx; }
.wheel.w-rl { left: 316rpx; top: 40rpx; }
.wheel.w-rr { left: 316rpx; top: 136rpx; }
.wheel .w-k { font-size: 17rpx; letter-spacing: 1rpx; }
.wheel .w-v { font-size: 25rpx; color: #FFFFFF; font-weight: 600; margin-top: 2rpx; }
.wheel .w-u { font-size: 17rpx; color: var(--tx-3); font-weight: 400; margin-left: 4rpx; }
.wheel .w-t { font-size: 17rpx; color: var(--tx-3); margin-top: 2rpx; }
.wheel.bad {
  border-color: rgba(255, 90, 79, 0.6);
  box-shadow: 0 0 0 6rpx rgba(255, 90, 79, 0.12), 0 0 22rpx rgba(255, 90, 79, 0.24), 0 12rpx 26rpx rgba(0, 0, 0, 0.55);
}
.wheel.bad .w-v { color: var(--bad); }

.loc-meta {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 2rpx;
}
.compass {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  background-color: rgba(255, 255, 255, 0.04);
  box-shadow: 0 0 0 8rpx rgba(77, 166, 255, 0.05), inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.comp-ic { width: 42rpx; height: 42rpx; opacity: 1; }
.loc-txt { min-width: 0; text-align: right; }
.loc-hd { display: flex; align-items: baseline; justify-content: flex-end; }
.loc-deg { font-size: 32rpx; color: #FFFFFF; font-weight: 500; }
.loc-dir { font-size: 19rpx; letter-spacing: 1.5rpx; margin-left: 12rpx; }
.loc-sub { margin-top: 8rpx; font-size: 19rpx; }
.addr { font-size: 23rpx; color: var(--tx-2); line-height: 1.8; margin-top: 24rpx; }
.snap {
  width: 100%;
  border-radius: 18rpx;
  margin-top: 16rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
}

.cab-grid {
  display: flex; flex-wrap: wrap; gap: 12rpx;
}
.cab-cell {
  width: calc(50% - 6rpx); box-sizing: border-box;
  border-radius: 18rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  padding: 20rpx 22rpx;
  min-height: 110rpx;
  display: flex; flex-direction: column; justify-content: space-between;
}
.cab-cell::before { content: none; }
.cab-top { display: flex; align-items: center; }
.cab-ic { width: 28rpx; height: 28rpx; opacity: 1; margin-right: 12rpx; flex-shrink: 0; }
.cab-k { font-size: 20rpx; color: var(--tx-3); }
.cab-v { margin-top: 14rpx; font-size: 24rpx; color: var(--tx-2); line-height: 1.5; }
.cab-v.strong { color: #FFFFFF; font-weight: 500; }
.air-v { display: flex; align-items: center; margin-top: 14rpx; }
.air-v .cab-v { margin-top: 0; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; margin-right: 12rpx; flex-shrink: 0; }
.dot.ok { background: var(--ok); box-shadow: 0 0 10rpx rgba(48, 192, 95, 0.6); }
.dot.acc { background: var(--acc); box-shadow: 0 0 12rpx rgba(77, 166, 255, 0.7); }
.dot.off { background: rgba(255, 255, 255, 0.2); }
.dot.na { background: rgba(255, 255, 255, 0.12); }

.sec-foot { padding-bottom: 24rpx; }
.foot { display: flex; justify-content: space-between; align-items: center; padding: 0 2rpx; }
.foot-link { display: flex; align-items: center; gap: 10rpx; }
.foot-link .go { width: 22rpx; height: 22rpx; opacity: 0.55; }