/* ============ 健康报告 v15：评分 hero 卡 + 分区卡片（手风琴） ============ */
.health { padding-top: 16rpx; }

/* ---------- 分区卡片 ---------- */
.sec { position: relative; }
.sec-seam { display: none; }
.seam-glint { display: none; }
.sec-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0;
}
.sec-stamp { display: flex; align-items: center; }
.sec-no {
  font-size: 22rpx; font-weight: 500;
  color: var(--tx-4);
  line-height: 1;
  margin-right: 16rpx;
  font-variant-numeric: tabular-nums;
}
.sec-title { font-size: 32rpx; font-weight: 600; line-height: 1.3; letter-spacing: -0.5rpx; }
.meta-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0 2rpx;
}
.meta-row .caps { font-size: 18rpx; letter-spacing: 2rpx; }
.meta-row .fine { font-size: 20rpx; }

/* 评分 hero 卡 */
.score {
  margin: 0 0 24rpx;
  padding: 40rpx 32rpx 44rpx;
  text-align: center;
  overflow: hidden;
}
.score-beam {
  position: absolute; top: 0; left: 12%; right: 12%; height: 440rpx;
  background: radial-gradient(60% 100% at 50% 0%, rgba(120, 200, 255, 0.17), rgba(120, 200, 255, 0.06) 48%, transparent 74%);
  pointer-events: none;
}
.score-ring { position: relative; width: 400rpx; height: 400rpx; margin: 0 auto; }
.ring {
  position: absolute;
  width: 400rpx; height: 400rpx;
  top: 0; left: 0;
}
.ring-num {
  position: absolute;
  inset: 0;
  display: flex; align-items: center; justify-content: center;
}
.ring-num .d1 { font-size: 116rpx; }
.ring-den { font-size: 26rpx; font-weight: 200; color: var(--tx-3); margin: 14rpx 0 0 10rpx; }
.score-cap-row {
  display: flex; align-items: center; justify-content: center;
  margin-top: 14rpx;
}
.sc-ic { width: 28rpx; height: 28rpx; opacity: 1; margin-right: 16rpx; }
.score-cap { font-size: 18rpx; letter-spacing: 2.5rpx; }

/* 状态计数 */
.counts {
  display: flex; justify-content: center; gap: 16rpx;
  margin-top: 38rpx;
}
.c {
  display: flex; align-items: center;
  font-size: 22rpx; color: var(--tx-3);
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.09);
  transition: all 0.25s ease;
}
.c.on.ok {
  color: var(--ok);
  background: rgba(48, 192, 95, 0.1);
  border-color: rgba(48, 192, 95, 0.4);
}
.c.on.warn {
  color: var(--warn);
  background: rgba(255, 179, 64, 0.1);
  border-color: rgba(255, 179, 64, 0.4);
}
.c.on.bad {
  color: var(--bad);
  background: rgba(255, 90, 79, 0.12);
  border-color: rgba(255, 90, 79, 0.45);
}
.c .num { font-variant-numeric: tabular-nums; }

.last-check { display: none; }

/* 系统折叠（面板内手风琴） */
.sys-head { display: none; }
.sh-side { display: flex; align-items: center; }
.sh-st.ok { color: var(--ok); }
.sh-st.warn { color: var(--warn); }
.sh-st.bad { color: var(--bad); text-shadow: 0 0 12rpx rgba(255, 90, 79, 0.3); }
.sh-st.na { color: var(--tx-4); }
.sec-head .sh-st { font-size: 21rpx; margin-right: 18rpx; }
.sh-arrow {
  width: 24rpx; height: 24rpx; opacity: 0.5;
  transition: transform 0.2s ease;
}
.sh-arrow.up { transform: rotate(180deg); }

.sys-body { padding-bottom: 8rpx; }
.it { padding: 30rpx 0 14rpx; }
.it + .it { border-top: 1rpx solid rgba(255, 255, 255, 0.05); }
.it-head { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; }
.it-name { font-size: 26rpx; font-weight: 500; line-height: 1.45; }
.it-st { font-size: 20rpx; }
.it-st.ok { color: var(--ok); }
.it-st.warn { color: var(--warn); }
.it-st.bad { color: var(--bad); }
.it-st.na { color: var(--tx-4); }