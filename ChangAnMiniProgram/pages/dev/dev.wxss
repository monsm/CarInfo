/* ============ 开发者工具 v15：分区卡片 ============ */
.dev { padding-top: 16rpx; }
.dev-eyebrow { padding: 18rpx 4rpx 34rpx; }
.dev-eyebrow .caps { font-size: 18rpx; letter-spacing: 2.5rpx; }

.mod-link { display: flex; align-items: center; gap: 10rpx; font-size: 21rpx; color: var(--tx-3); }
.mod-link text { font-size: 21rpx; }

/* ---------- 分区卡片 ---------- */
.sec { position: relative; }
.sec-seam { display: none; }
.seam-glint { display: none; }
.sec-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0 2rpx;
}
.sec-stamp { display: flex; align-items: center; }
.sec-no {
  font-size: 22rpx; font-weight: 500;
  color: var(--tx-4);
  line-height: 1;
  margin-right: 16rpx;
  font-variant-numeric: tabular-nums;
}
.sec-tt { display: flex; flex-direction: column; }
.sec-title { font-size: 32rpx; font-weight: 600; line-height: 1.3; letter-spacing: -0.5rpx; }
.sec-en { font-size: 17rpx; letter-spacing: 2rpx; margin-top: 4rpx; }

.log-body {
  max-height: 440rpx;
  margin-top: 24rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
  background-color: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  padding: 26rpx 30rpx;
  box-sizing: border-box;
}
.log-line {
  font-size: 19rpx;
  color: var(--tx-3);
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
}
.log-acts { display: flex; gap: 16rpx; margin-top: 28rpx; }
.act-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--tx-2);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.04));
  background-color: rgba(255, 255, 255, 0.035);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.09);
}
.act-pill .act-ic { width: 26rpx; height: 26rpx; opacity: 1; }
.act-pill.danger { color: var(--bad); border-color: rgba(255, 90, 79, 0.35); }

.dev-foot {
  text-align: center;
  padding: 80rpx 0 10rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}