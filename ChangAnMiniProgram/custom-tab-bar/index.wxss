/* 底部导航 v15：Apple 液态玻璃悬浮坞
   ------------------------------------------------------------
   · 悬浮胶囊：左右留边、悬浮于底部，不贴死屏幕边缘；
   · 材质：半透明深灰 + backdrop blur(70rpx) saturate(1.9)，
     顶部渐变高光 + 发丝描边 + 双层投影（外投影 / 内高光）；
   · 选中态：高光胶囊（raised glass capsule），图标提亮带辉光，
     文字加白加粗，替代 v14 的顶部细指示条。 */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 122rpx;
  display: flex;
  align-items: stretch;
  padding: 12rpx;
  box-sizing: border-box;
  border-radius: 44rpx;
  background-image:
    linear-gradient(180deg, rgba(255, 255, 255, 0.20), rgba(255, 255, 255, 0.08) 52%, rgba(255, 255, 255, 0.12));
  background-color: rgba(16, 20, 28, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.20);
  box-shadow:
    0 32rpx 72rpx -24rpx rgba(0, 0, 0, 0.78),
    0 8rpx 24rpx rgba(0, 0, 0, 0.35),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.18),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.28);
  -webkit-backdrop-filter: blur(70rpx) saturate(1.9);
  backdrop-filter: blur(70rpx) saturate(1.9);
  z-index: 999;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  border-radius: 32rpx;
  position: relative;
  transition: background 0.2s ease, box-shadow 0.2s ease;
}
.tab .icon {
  width: 44rpx; height: 44rpx;
  opacity: 0.5;
  transition: opacity 0.18s ease, transform 0.18s ease;
}
.tab .label {
  font-size: 20rpx;
  color: var(--tx-4, #49525F);
  line-height: 1.3;
  letter-spacing: 0.5rpx;
  transition: color 0.18s ease;
}
/* 选中：高光胶囊 + 图标辉光 */
.tab.on {
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.11));
  background-color: rgba(255, 255, 255, 0.05);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.28),
    inset 0 -8rpx 18rpx rgba(255, 255, 255, 0.06),
    0 12rpx 26rpx -12rpx rgba(0, 0, 0, 0.65);
}
.tab.on .icon {
  opacity: 1;
  transform: translateY(-1rpx) scale(1.04);
  filter: drop-shadow(0 0 10rpx rgba(255, 255, 255, 0.45));
}
.tab.on .label { color: #FFFFFF; font-weight: 600; }

.safe-area { height: 0; }
