page {
  --bg: #0B0D12;
  --tx: #F2F4F8;
  --tx-2: #AAB2C0;
  --tx-3: #8A94A5;
  --tx-4: #647084;

  --ok: #30C05F;
  --warn: #FFB340;
  --bad: #FF5A4F;

  --acc: #4DA6FF;
  --acc-2: #3D7BFF;

  --surface: #141821;
  --surface-2: #181D27;
  --line: rgba(255, 255, 255, 0.08);
  --line-strong: rgba(255, 255, 255, 0.14);

  background:
    radial-gradient(1200rpx 420rpx at 50% -10%, rgba(200, 215, 235, 0.13), transparent 65%),
    radial-gradient(560rpx 440rpx at 12% -4%, rgba(77, 166, 255, 0.16), transparent 70%),
    radial-gradient(500rpx 420rpx at 90% 14%, rgba(48, 192, 95, 0.10), transparent 70%),
    radial-gradient(640rpx 520rpx at 50% 58%, rgba(61, 123, 255, 0.08), transparent 72%),
    radial-gradient(480rpx 420rpx at 4% 104%, rgba(255, 179, 64, 0.07), transparent 72%),
    var(--bg);
  background-color: var(--bg);
  color: var(--tx);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue",
    "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
  -webkit-tap-highlight-color: transparent;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(178rpx + env(safe-area-inset-bottom));
}
.page.no-tab { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.px { padding-left: 32rpx; padding-right: 32rpx; }

.glass {
  position: relative;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.06) 16%, rgba(255, 255, 255, 0.03) 45%, rgba(255, 255, 255, 0.05));
  background-color: rgba(24, 30, 42, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 28rpx;
  box-shadow:
    0 30rpx 70rpx -26rpx rgba(0, 0, 0, 0.72),
    0 4rpx 14rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.16),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.2);
  -webkit-backdrop-filter: blur(52rpx) saturate(1.8);
  backdrop-filter: blur(52rpx) saturate(1.8);
  overflow: hidden;
}
.glass::before {
  content: '';
  position: absolute;
  top: 0; left: 6%; right: 6%; height: 110rpx;
  background: radial-gradient(50% 100% at 50% 0%, rgba(255, 255, 255, 0.11), transparent 72%);
  pointer-events: none;
}
.glass-hero {
  position: relative;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08) 16%, rgba(255, 255, 255, 0.04) 45%, rgba(255, 255, 255, 0.06));
  background-color: rgba(28, 35, 48, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.19);
  border-radius: 30rpx;
  box-shadow:
    0 36rpx 80rpx -30rpx rgba(0, 0, 0, 0.8),
    0 4rpx 16rpx rgba(0, 0, 0, 0.32),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.20),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.24);
  -webkit-backdrop-filter: blur(58rpx) saturate(1.85);
  backdrop-filter: blur(58rpx) saturate(1.85);
  overflow: hidden;
}
.glass-hero::before {
  content: '';
  position: absolute;
  top: 0; left: 4%; right: 4%; height: 150rpx;
  background: radial-gradient(50% 100% at 50% 0%, rgba(255, 255, 255, 0.14), transparent 72%);
  pointer-events: none;
}
.glass-hero::after { content: none; }
.glass-hi {
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.04));
  background-color: rgba(22, 26, 34, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 28rpx;
  box-shadow:
    0 24rpx 60rpx -20rpx rgba(0, 0, 0, 0.6),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  -webkit-backdrop-filter: blur(60rpx) saturate(1.7);
  backdrop-filter: blur(60rpx) saturate(1.7);
}

.gcell {
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12), 0 8rpx 20rpx -8rpx rgba(0, 0, 0, 0.4);
}
.gcell::before { content: none; }

.sec {
  position: relative;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.06) 16%, rgba(255, 255, 255, 0.03) 45%, rgba(255, 255, 255, 0.05));
  background-color: rgba(24, 30, 42, 0.52);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 28rpx;
  box-shadow:
    0 30rpx 70rpx -26rpx rgba(0, 0, 0, 0.72),
    0 4rpx 14rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.16),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.2);
  -webkit-backdrop-filter: blur(52rpx) saturate(1.8);
  backdrop-filter: blur(52rpx) saturate(1.8);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.sec::before {
  content: '';
  position: absolute;
  top: 0; left: 6%; right: 6%; height: 110rpx;
  background: radial-gradient(50% 100% at 50% 0%, rgba(255, 255, 255, 0.11), transparent 72%);
  pointer-events: none;
}
.sec:last-child { margin-bottom: 0; }
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  margin-bottom: 0;
}
.sec-stamp { display: flex; align-items: center; min-width: 0; }
.sec-no { display: none; }
.sec-en { display: none; }
.sec-tt { min-width: 0; }
.sec-title { font-size: 32rpx; font-weight: 600; line-height: 1.3; letter-spacing: -0.5rpx; }
.sec-side { font-size: 22rpx; font-weight: 500; flex-shrink: 0; }
.sec-side.ok { color: var(--tx-3); }
.sec-side.warn { color: var(--warn); }
.sec-side.bad { color: var(--bad); text-shadow: 0 0 14rpx rgba(255, 90, 79, 0.3); }
.sec-side.na { color: var(--tx-4); }
.sec-seam { display: none; }
.seam-glint { display: none; }

.row { display: flex; align-items: flex-start; padding: 26rpx 0; }
.row + .row { border-top: 1rpx solid rgba(255, 255, 255, 0.05); }
.row .k {
  color: var(--tx-3);
  font-size: 24rpx;
  flex: 0 0 auto;
  max-width: 300rpx;
  line-height: 1.6;
  padding-top: 5rpx;
}
.row .k.dim { color: var(--tx-4); }
.row .v {
  color: var(--tx-2);
  text-align: right;
  flex: 1;
  min-width: 0;
  padding-left: 28rpx;
  word-break: break-all;
  line-height: 1.65;
}
.row .v.strong { color: var(--tx); font-weight: 500; }
.row .v.small { font-size: 23rpx; }
.row .go { width: 22rpx; height: 22rpx; opacity: 0.55; margin-left: 14rpx; flex-shrink: 0; }
.glass .row { padding: 26rpx 0; }

.pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.045));
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  font-size: 20rpx;
  color: var(--tx-2);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}
.pill .dot { width: 10rpx; height: 10rpx; border-radius: 50%; margin-right: 12rpx; }
.pill.ok { color: var(--ok); }
.pill.ok .dot { background: var(--ok); box-shadow: 0 0 10rpx rgba(48, 192, 95, 0.6); }
.pill.warn { color: var(--warn); }
.pill.warn .dot { background: var(--warn); box-shadow: 0 0 10rpx rgba(255, 179, 64, 0.6); }
.pill.bad { color: var(--bad); }
.pill.bad .dot { background: var(--bad); box-shadow: 0 0 10rpx rgba(255, 90, 79, 0.6); }
.pill.na { color: var(--tx-3); }
.pill.na .dot { background: rgba(255, 255, 255, 0.18); }
.pill.acc { color: var(--acc); }
.pill.acc .dot { background: var(--acc); box-shadow: 0 0 10rpx rgba(77, 166, 255, 0.6); }
.glass-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.045));
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 20rpx;
  color: var(--tx-2);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.11);
}

.mod {
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
}
.mod-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
}
.mod-more { font-size: 22rpx; color: var(--tx-3); }
.mod-more.ok { color: var(--ok); }
.mod-more.warn { color: var(--warn); }
.mod-more.bad { color: var(--bad); }
.mod-more.na { color: var(--tx-4); }
.mod-action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.045));
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  font-size: 22rpx;
  color: var(--tx-2);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.11);
}
.mod-action .mod-action-ic { width: 26rpx; height: 26rpx; opacity: 0.95; }
.mod-link {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  color: var(--tx-3);
}
.mod-link image { width: 20rpx; height: 20rpx; opacity: 0.6; }
.mod-link.dim { opacity: 0.35; }

.num { font-variant-numeric: tabular-nums; }
.d1 { font-size: 128rpx; font-weight: 200; line-height: 1; letter-spacing: -4rpx; font-variant-numeric: tabular-nums; }
.d2 { font-size: 96rpx; font-weight: 200; line-height: 1; letter-spacing: -3rpx; font-variant-numeric: tabular-nums; }
.d3 { font-size: 60rpx; font-weight: 250; line-height: 1.05; letter-spacing: -2rpx; font-variant-numeric: tabular-nums; }
.h1 { font-size: 50rpx; font-weight: 600; line-height: 1.15; letter-spacing: -1rpx; }
.h2 { font-size: 40rpx; font-weight: 600; line-height: 1.2; letter-spacing: -0.5rpx; }
.t1 { font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.t2 { font-size: 30rpx; font-weight: 400; line-height: 1.7; }
.body { font-size: 28rpx; line-height: 1.7; }
.small { font-size: 24rpx; line-height: 1.7; }
.fine { font-size: 20rpx; line-height: 1.6; }

.caps {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--tx-3);
}
.caps.b { color: var(--tx-2); }
.caps.muted { color: var(--tx-3); }

.t-2 { color: var(--tx-2); } .t-3 { color: var(--tx-3); } .t-4 { color: var(--tx-4); }
.t-ok { color: var(--ok); } .t-warn { color: var(--warn); } .t-bad { color: var(--bad); } .t-acc { color: var(--acc); }

.hairline { height: 1rpx; background: var(--line); }
.spacer { height: 30rpx; }
.sp8 { height: 8rpx; } .sp16 { height: 16rpx; } .sp24 { height: 24rpx; } .sp32 { height: 32rpx; } .sp48 { height: 48rpx; }

.btn-primary {
  background: linear-gradient(180deg, #FFFFFF, #E4E9F0);
  color: #000000;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  letter-spacing: 1rpx;
  text-align: center;
  box-shadow: 0 14rpx 40rpx -12rpx rgba(255, 255, 255, 0.22), inset 0 -2rpx 6rpx rgba(0, 0, 0, 0.08);
}
.btn-primary[disabled] { opacity: 0.35; }
.btn-ghost {
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.04));
  background-color: rgba(255, 255, 255, 0.04);
  color: var(--tx);
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 999rpx;
  font-size: 30rpx;
  height: 96rpx;
  line-height: 94rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}
.btn-danger-text { color: var(--bad); font-size: 26rpx; text-align: center; padding: 20rpx 0; }
.ghost-ic {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.ghost-ic .ghost-ic-img { width: 32rpx; height: 32rpx; }

.input {
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.04));
  background-color: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 18rpx;
  height: 96rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  color: var(--tx);
  box-sizing: border-box;
  width: 100%;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.11);
}
.ph { color: var(--tx-3); }

.status-line { font-size: 22rpx; color: var(--tx-3); padding: 14rpx 0 24rpx; min-height: 36rpx; }
.status-line.ok { color: var(--ok); }
.status-line.err { color: var(--bad); }

.empty { padding: 110rpx 40rpx; text-align: center; }
.empty image { width: 56rpx; height: 56rpx; opacity: 0.35; margin-bottom: 26rpx; }
.empty .e-t { font-size: 30rpx; color: var(--tx-2); }
.empty .e-s { font-size: 24rpx; color: var(--tx-3); margin-top: 10rpx; line-height: 1.7; }
.empty .btn-ghost { margin: 40rpx auto 0; width: 260rpx; height: 84rpx; line-height: 82rpx; font-size: 28rpx; }

.sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.66);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1300;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.05));
  background-color: rgba(20, 24, 32, 0.68);
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 -24rpx 80rpx rgba(0, 0, 0, 0.6), inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  -webkit-backdrop-filter: blur(70rpx) saturate(1.6);
  backdrop-filter: blur(70rpx) saturate(1.6);
  padding: 24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.sheet .grab {
  width: 68rpx; height: 8rpx; border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 auto 26rpx;
}
.sheet .title { font-size: 36rpx; font-weight: 600; color: #FFFFFF; letter-spacing: -0.5rpx; }
.sheet .sub { font-size: 22rpx; color: var(--tx-3); margin: 8rpx 0 30rpx; line-height: 1.55; }
.sheet .btns { display: flex; gap: 20rpx; margin-top: 32rpx; }
.sheet .btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.sheet .btn.cancel {
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.06));
  background-color: rgba(255, 255, 255, 0.04);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}
.sheet .btn.ok {
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.20), rgba(255, 255, 255, 0.10));
  background-color: rgba(255, 255, 255, 0.08);
  color: #FFFFFF;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.16);
}
.sheet .btn.ok.ready { background: #FFFFFF; color: #000000; font-weight: 600; }

@keyframes pageIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.ent { animation: pageIn 0.28s ease-out; }

.pressable { transition: opacity 0.14s ease; }
.pressable:active { opacity: 0.55; }
.softpress { transition: transform 0.16s ease, opacity 0.14s ease; }
.softpress:active { transform: scale(0.97); opacity: 0.9; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes breath { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }

.mono { font-family: Menlo, Consolas, "Courier New", monospace; }
.safe-bottom { height: env(safe-area-inset-bottom); }