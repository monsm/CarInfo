<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>长安车管家</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>location-services</string>
    </array>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于显示车辆当前位置</string>
    <key>NSCameraUsageDescription</key>
    <string>用于拍摄车辆照片</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>用于选择车辆照片</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>用于保存车辆照片到相册</string>
    <key>NSFaceIDUsageDescription</key>
    <string>用于验证身份后访问敏感信息</string>
    <!-- 2026-09-23 删掉的死键（留着就是在说一件不存在的事）：
           · NSHealthShareUsageDescription / NSHealthUpdateUsageDescription
             —— HealthKit 的用途说明。读健康数据的代码早已删除，HealthKit
                也是要注册的能力（免费账号用不了），系统只会问一个永远不会发生的权限。
           · CKCloudKitEnabled —— iCloud/CloudKit 的残留开关，同步那套代码早已删光。 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>CFBundleLocalizations</key>
    <array>
        <string>zh_CN</string>
    </array>
</dict>
</plist>
