<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- CarPlay 扩展不需要网络权限，所有数据来自 App Group 快照 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.you.CarKeeper</string>
    </array>
    <!-- 以下两个能力键为可选：
         - carplay-car-registration：需要 Apple 审批（通常针对 OEM），个人开发者的
           App 不设这个也能在车机上显示，只是不会出现在「已认证的车辆」列表里。
         - carplay-audio：音频类 App 才需要，车况 App 用不到。
         两者都设为 false 即可。 -->
    <key>com.apple.developer.carplay-car-registration</key>
    <false/>
    <key>com.apple.developer.carplay-audio</key>
    <false/>
</dict>
</plist>
